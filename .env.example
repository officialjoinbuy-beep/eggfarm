# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# 절대 프론트엔드에 노출되면 안됨 (서버 API route에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# 공구 생성 한도 소진 시 안내 모달에 뜨는 오픈채팅 문의 링크
NEXT_PUBLIC_SUPPORT_CHAT_URL=https://open.kakao.com/o/xxxxxxx

# 체험계정 자동삭제 cron API 보호용 (Vercel Cron 헤더와 대조, 선택)
CRON_SECRET=

# 크레딧 추가구매 안내용 입금계좌 정보
NEXT_PUBLIC_CREDIT_BANK_NAME=
NEXT_PUBLIC_CREDIT_BANK_ACCOUNT=
NEXT_PUBLIC_CREDIT_BANK_HOLDER=

# 크레딧 구매 후 재초대 안내에 쓰이는 진행자 계정 정보
NEXT_PUBLIC_ARININE_GITHUB_ID=
NEXT_PUBLIC_ARININE_VERCEL_EMAIL=
NEXT_PUBLIC_ARININE_SUPABASE_EMAIL=

# 위임배송 담당자 이름/연락처, 공동현관 비밀번호 암호화 키 (32바이트 hex, 예: openssl rand -hex 32)
STAFF_ENC_KEY=

# 운영 콘솔(진행자 전용) 로그인 비밀번호
CONSOLE_ADMIN_PASSWORD=

# 카카오 디벨로퍼스 - 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 카카오 디벨로퍼스에서 "클라이언트 시크릿 사용"을 활성화한 경우에만 필요
# (앱 > 플랫폼 키 > 대표 REST API 키 상세 > 클라이언트 시크릿)
KAKAO_CLIENT_SECRET=

# 진행자(ARININE) 본인이 크레딧 구매요청 알림을 카톡으로 받기 위한 토큰
# /console/kakao-setup 에서 1회 인증 후 나오는 값을 그대로 붙여넣으면 됩니다
KAKAO_ADMIN_REFRESH_TOKEN=

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX), 없으면 GA4 스크립트 자체가 삽입되지 않음
NEXT_PUBLIC_GA_MEASUREMENT_ID=
